# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token.
# The bot needs the "Message Content Intent" toggled ON (Bot page) so it can read
# the links people post in the handles channel, and it needs Read Messages +
# Send Messages permission on both channels below.
DISCORD_BOT_TOKEN=

# Right-click a channel in Discord (with Developer Mode on) -> Copy Channel ID.
# SOURCE = the channel where creator handles/links live.
# TARGET = the channel where new videos get posted.
DISCORD_SOURCE_CHANNEL_ID=
DISCORD_TARGET_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Storage (Upstash Redis via the Vercel Marketplace integration)
# ---------------------------------------------------------------------------
# The Vercel integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.
# The UPSTASH_* names are a fallback if you provision Upstash directly.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Cron protection
# ---------------------------------------------------------------------------
# Vercel sends `Authorization: Bearer $CRON_SECRET` on scheduled invocations.
# Set any long random string here and in the Vercel project env vars.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Scrapers (only needed for TikTok / Instagram — YouTube needs nothing)
# ---------------------------------------------------------------------------
# Provider for TikTok + Instagram lookups: "apify" or "rapidapi" or "none".
SCRAPER_PROVIDER=none

# Apify: token from https://console.apify.com/account/integrations
APIFY_TOKEN=
# Override the actors if you prefer different ones.
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper

# RapidAPI: key from https://rapidapi.com (subscribe to a TikTok/Instagram API).
RAPIDAPI_KEY=
RAPIDAPI_TIKTOK_HOST=tiktok-scraper7.p.rapidapi.com
RAPIDAPI_INSTAGRAM_HOST=instagram-scraper-api2.p.rapidapi.com

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# How many creators to check per cron run. Keeps a single run inside the
# function time limit; the bot rotates through the full list across runs.
MAX_CREATORS_PER_RUN=25

# How many of a creator's most recent videos to inspect each check.
VIDEOS_PER_CHECK=5

# Max posts per run, so a burst can never spam the target channel.
MAX_POSTS_PER_RUN=15

# What to do the first time a creator is seen:
#   none   = mark their existing videos as seen, post nothing (default)
#   latest = post only their single newest video
BACKFILL_ON_ADD=none

# Message template. {name} {url} {platform} {title} are substituted.
POST_TEMPLATE=**{name}** just posted on {platform}
{url}
