# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token.
# The bot needs the "Message Content Intent" toggled ON (Bot page) so it can read
# the links people post in the handles channel, and it needs Read Messages +
# Send Messages permission on both channels below.
DISCORD_BOT_TOKEN=

# Right-click a channel in Discord (with Developer Mode on) -> Copy Channel ID.
# SOURCE = the channel where creator handles/links live.
# TARGET = the channel where new videos get posted.
DISCORD_SOURCE_CHANNEL_ID=
DISCORD_TARGET_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Storage (Upstash Redis via the Vercel Marketplace integration)
# ---------------------------------------------------------------------------
# The Vercel integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.
# The UPSTASH_* names are a fallback if you provision Upstash directly.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Cron protection
# ---------------------------------------------------------------------------
# Vercel sends `Authorization: Bearer $CRON_SECRET` on scheduled invocations.
# Set any long random string here and in the Vercel project env vars.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Scrapers (only needed for TikTok / Instagram — YouTube needs nothing)
# ---------------------------------------------------------------------------
# Provider for TikTok + Instagram lookups:
#   "scrapecreators" | "apify" | "rapidapi" | "none"
# "none" disables those two platforms; YouTube keeps working either way.
SCRAPER_PROVIDER=none

# ScrapeCreators: key from https://scrapecreators.com — costs 1 credit per
# creator checked. Every response reports the remaining balance, and the cron
# summary surfaces the lowest one it saw as `creditsRemaining`.
SCRAPECREATORS_API_KEY=

# Apify: token from https://console.apify.com/account/integrations
APIFY_TOKEN=
# Override the actors if you prefer different ones.
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper

# RapidAPI: key from https://rapidapi.com (subscribe to a TikTok/Instagram API).
RAPIDAPI_KEY=
RAPIDAPI_TIKTOK_HOST=tiktok-scraper7.p.rapidapi.com
RAPIDAPI_INSTAGRAM_HOST=instagram-scraper-api2.p.rapidapi.com

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# THE CREDIT DIAL. How many TikTok/Instagram creators to check per run. Each
# one costs exactly one scraper credit, so this number is the run's bill.
# The bot rotates through the rest on later runs, so nobody is ever skipped
# permanently. YouTube creators are NOT counted here — RSS is free, so all of
# them are checked every run regardless of this setting.
#
#   credits/day = MAX_METERED_PER_RUN x runs-per-day
#
MAX_METERED_PER_RUN=10

# How many of a creator's most recent videos to inspect each check.
VIDEOS_PER_CHECK=5

# Creators that have never posted a single video are re-checked on an
# escalating delay (30m, 1h, 2h, 4h, then capped) instead of every run, which
# frees their credit slot for creators who are actually active. The delay
# resets the moment they post anything, so a debut is never missed by more
# than the current wait. Applies to TikTok/Instagram only -- YouTube is free,
# so slowing it down would buy nothing.
#
# Set a date to schedule activation; leave blank to enable immediately.
BACKOFF_START_AT=

# Warn in the target channel when scraper credits drop below this, at most once
# every 12 hours. Set to 0 to disable. Without it, TikTok/Instagram fail quietly
# when the balance hits zero while YouTube keeps posting, which is easy to miss.
LOW_CREDIT_WARNING=500

# Max posts per run, so a burst can never spam the target channel.
MAX_POSTS_PER_RUN=15

# Creators to skip even though their links are in the handles channel, as a
# comma-separated list of platform:handle. Useful when another bot already
# announces them in the same channel. Skipping a TikTok/Instagram creator also
# saves one scraper credit per run.
#   IGNORE_CREATORS=instagram:sophierosesdiary,instagram:braedontrades
IGNORE_CREATORS=

# What to do the first time a creator is seen:
#   none   = mark their existing videos as seen, post nothing (default)
#   latest = post only their single newest video
BACKFILL_ON_ADD=none

# Message template. {name} {url} {platform} {title} are substituted.
POST_TEMPLATE=**{name}** just posted on {platform}
{url}
